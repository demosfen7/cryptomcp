# Сайт cryptomcp для прод-Caddy. Копируется в conf.d Caddy briefgenerator:
#   /opt/briefgenerator/deploy/conf.d/cryptomcp.aithinglab.com.caddy
# Проксирует на контейнер cryptomcp (/opt/cryptomcp). Авто-HTTPS (Let's Encrypt).
#
# CI этот файл НЕ копирует: общий Caddy обслуживает все проекты сразу, и деплой
# одного не должен затирать роутинг соседнего. Правки вносятся вручную.
#
# Аутентификация живёт в самом приложении (cryptomcp/app.py), а не здесь: иначе
# Caddy понадобилась бы переменная с токеном, то есть правка compose чужого
# проекта. Путь /health намеренно открыт — им пользуется деплой.
cryptomcp.aithinglab.com {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy cryptomcp:8000 {
		# MCP по streamable-http держит SSE-поток — буферизация ответа не нужна.
		flush_interval -1
		transport http {
			# Постраничная догрузка истории на 5m занимает несколько секунд.
			response_header_timeout 180s
		}
	}
}
