# Ключ владельца: вводится один раз на OAuth-странице подключения.
# Заодно остаётся совместимым Bearer/x-api-key для старых клиентов.
# Сгенерировать: openssl rand -hex 32. На сервере лежит в
# /opt/cryptomcp/.env, в репозиторий не попадает.
MCP_AUTH_TOKEN=

# Бот и группа для уведомлений о дельте списка наблюдения. Необязательны:
# без них сборщик работает молча, ничего не ломается. Chat id у группы
# отрицательный; у супергруппы он начинается на -100 и отличается от того,
# что был у обычной группы до преобразования.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Личный бот со сценариями. Пустой список — безопасное умолчание: кроме /id
# бот никому не отвечает. Владелец узнаёт свой id командой /id, затем кладёт
# его сюда через секрет GitHub и пишет боту /start в личном чате.
BOT_ALLOWED_USER_IDS=
BOT_DAILY_BUDGET_USD=1.0
BOT_TIMEZONE=Europe/Berlin
BOT_MORNING_TIME=08:00
