# Токен доступа к MCP-серверу. Сгенерировать:  openssl rand -hex 32
# На сервере лежит в /opt/cryptomcp/.env, в репозиторий не попадает.
MCP_AUTH_TOKEN=

# Бот и группа для уведомлений о дельте списка наблюдения. Необязательны:
# без них сборщик работает молча, ничего не ломается. Chat id у группы
# отрицательный; у супергруппы он начинается на -100 и отличается от того,
# что был у обычной группы до преобразования.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
